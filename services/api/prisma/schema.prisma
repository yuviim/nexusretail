generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  warehouses Warehouse[]
  products   Product[]
  customers  Customer[]
  orders     Order[]
  suppliers  Supplier[]
  purchaseOrders PurchaseOrder[]
  processedInvoices ProcessedInvoice[]

  @@map("tenants")
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  email     String   @unique
  // Cognito's immutable subject claim. Nullable because rows created before
  // this column existed need a one-time backfill (see the migration and
  // scripts/backfill-cognito-sub.ts) — requireAuth refuses to authenticate
  // a token whose sub has no matching row, so an un-backfilled user is
  // simply locked out rather than silently falling back to email lookup.
  cognitoSub String?  @unique
  name       String
  role       String   @default("staff") // owner | staff | read_only
  createdAt  DateTime @default(now())

  @@map("users")
}

model Warehouse {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  stockLevels StockLevel[]
  purchaseOrders PurchaseOrder[]

  @@map("warehouses")
}

model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  sku           String
  name          String
  reorderPoint  Int      @default(0)
  unitPrice     Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  stockLevels StockLevel[]
  orderItems  OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@map("products")
}

model StockLevel {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantityOnHand Int @default(0)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  orders Order[]

  @@map("customers")
}

model Order {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status    String   @default("placed") // placed | stock_reserved | payment | fulfilled
  createdAt DateTime @default(now())

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model Supplier {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  name String

  @@map("suppliers")
}

model PurchaseOrder {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  poNumber     String
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  status       String   @default("open") // open | matched | flagged | closed
  matchDetails Json?
  createdAt    DateTime @default(now())
  items        PurchaseOrderItem[]

  // Which warehouse receives the stock on approval. Nullable because
  // existing POs predate this column; approve() requires it be set (either
  // already, or passed in on the approve call) before it will touch stock —
  // it no longer guesses by taking stockLevels[0].
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  processedInvoices ProcessedInvoice[]

  @@unique([tenantId, poNumber])
  @@map("purchase_orders")
}

// One row per invoice file we've actually processed for a tenant, keyed by
// a hash of the file bytes. Re-uploading the identical file is rejected
// before it reaches Textract or touches a PO a second time.
model ProcessedInvoice {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  fileHash        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([tenantId, fileHash])
  @@map("processed_invoices")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  expectedQty       Int
  expectedUnitPrice Decimal       @db.Decimal(10, 2)

  @@map("purchase_order_items")
}
