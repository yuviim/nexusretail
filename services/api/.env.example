# Copy to .env and fill in. `docker compose up` reads this automatically
# via docker-compose.yml; running the API directly needs it loaded some
# other way (the api already does `import "dotenv/config"` via
# prisma.config.ts's chain, so a plain .env in this directory is picked up).

# Postgres connection string. The value below matches docker-compose.yml's
# db service — change host/port if you're pointing at something else (a
# tunneled RDS instance, a different local Postgres).
DATABASE_URL="postgresql://nexusretail:nexusretail@localhost:5432/nexusretail?schema=public"

# --- Auth ---
# AUTH_MODE=local skips real Cognito entirely — requireAuth accepts a fixed
# dev token and maps it to one of the users seeded by prisma/seed.ts. This
# is what makes `docker compose up` runnable without an AWS account. It
# refuses to start with NODE_ENV=production, so it can't end up live by
# accident.
#
# Leave this unset (or set to "cognito") to use real Cognito, and fill in
# the two values below from `terraform output` in
# infra/terraform/environments/dev.
AUTH_MODE=local
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

AWS_REGION=eu-central-1

# --- Invoice upload + matching ---
# TEXTRACT_MODE=mock returns a canned extraction from samples/ instead of
# calling real Textract — see samples/README.md for which sample file
# produces which match outcome. Leave unset to call real Textract (needs
# real AWS credentials and an actual S3 object).
TEXTRACT_MODE=mock
# STORAGE_MODE=local saves uploaded invoices to ./uploads instead of S3.
# Leave unset to use real S3 (needs INVOICES_BUCKET and real credentials).
STORAGE_MODE=local
INVOICES_BUCKET=

ALLOWED_ORIGIN=http://localhost:5173
PORT=3000
