# Copy to .env and fill in. Vite only exposes variables prefixed VITE_ to
# the browser bundle — see vite.config.ts if you're adding a new one.

# Where the web app sends API requests. Matches services/api's PORT in
# docker-compose.yml / .env.example.
VITE_API_BASE_URL=http://localhost:3000

# Must match the API's AUTH_MODE. 'local' signs in via POST
# /auth/local-login (email only, no password, no real Cognito) against one
# of the users prisma/seed.ts created — see src/lib/auth.ts. Set both this
# and the API's AUTH_MODE to 'cognito' together for real Cognito sign-in.
VITE_AUTH_MODE=local

# Only used when VITE_AUTH_MODE=cognito.
VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_APP_CLIENT_ID=
