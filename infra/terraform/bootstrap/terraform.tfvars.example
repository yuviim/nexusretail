# Copy to terraform.tfvars and fill in (or pass -var on the CLI). Must
# match environments/dev/terraform.tfvars.example's values exactly — both
# roots compute the same state-bucket/lock-table names from these.
aws_account_id = "111111111111"
# project_name defaults to "nexusretail" — override only if you want to run
# more than one copy of this stack in the same account.
